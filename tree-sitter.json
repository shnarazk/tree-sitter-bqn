{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bqn",
      "camelcase": "BQN",
      "title": "BQN",
      "scope": "source.bqn",
      "file-types": [
        "bqn"
      ],
      "injection-regex": "^bqn$",
      "class-name": "TreeSitterBqn"
    }
  ],
  "metadata": {
    "version": "0.3.2",
    "license": "MPL2.0",
    "description": "BQN grammar for tree-sitter",
    "authors": [
      {
        "name": "Narazaki, Shuji",
        "url": "https://github.com/shnarazk"
      }
    ],
    "links": {
      "repository": "https://github.com/shnarazk/tree-sitter-bqn"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
